font-family = "SF Mono"
font-size = 12
font-thicken = true
font-thicken-strength = 64
adjust-cell-width = -4%
adjust-cell-height = 4%
adjust-cursor-thickness = 2
quit-after-last-window-closed = true
fullscreen = true
shell-integration-features = ssh-terminfo,ssh-env,sudo
link-url = true

theme = light:base16-bright-light,dark:base16-bright-dark
window-theme = system
